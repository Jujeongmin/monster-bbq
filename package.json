{
  "name": "monster-bbq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "npm --prefix server test",
    "server:typecheck": "npm --prefix server run typecheck"
  },
  "dependencies": {
    "@agent8/gameserver": "^2.0.1",
    "@verse8/ads": "^0.5.0",
    "@verse8/platform": "^2.1.0",
    "phaser": "3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.7.3",
    "vite": "^8.3.3",
    "vitest": "^3.2.7"
  }
}
