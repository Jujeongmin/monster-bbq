{
  "name": "monster-bbq-server",
  "version": "0.1.0",
  "description": "몬스터 고깃집 Verse8 game server",
  "private": true,
  "scripts": {
    "build": "gameserver-node build",
    "build:dev": "gameserver-node build --no-minify",
    "watch": "gameserver-node build --watch",
    "test": "gameserver-node test",
    "test:dev": "gameserver-node test --no-minify",
    "dev": "gameserver-node dev",
    "dev:readable": "gameserver-node dev --no-minify",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@agent8/gameserver-node": "^2.0.1",
    "typescript": "~5.7.3"
  }
}
