{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "../shared/**/*",
    "./node_modules/@agent8/gameserver-node/types/**/*.d.ts"
  ],
  "exclude": ["../shared/**/*.test.ts"]
}
